NODE_ENV=development
PORT=3000
LOG_LEVEL=info
LOG_PROMPTS=false
CORS_ORIGIN=*
BODY_LIMIT=1mb
DATABASE_URL=postgres://postgres:postgres@postgres:5432/llm_gateway
REDIS_URL=redis://redis:6379
DB_RUN_MIGRATIONS=true
ADMIN_API_KEY=change-me
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
ENABLED_PROVIDERS=openai,anthropic,ollama
REQUEST_TIMEOUT_MS=60000
PROVIDER_RETRIES=1
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
RATE_LIMIT_ENABLED=true
DEFAULT_RPM=60
DEFAULT_MONTHLY_TOKEN_QUOTA=0
FALLBACK_ENABLED=false
FALLBACK_MODELS=
PRICE_TABLE_JSON={}
\nMODEL_ROUTES_JSON={"openai":["gpt-*","o1*","o3*","o4*"],"anthropic":["claude-*"],"ollama":["ollama/*"]}\nMODEL_ALIASES_JSON={"fast":"gpt-4o-mini","smart":"claude-sonnet-4-5"}\n